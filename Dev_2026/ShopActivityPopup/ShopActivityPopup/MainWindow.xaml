<Window x:Class="ShopActivityPopup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="#FAFAFA" CornerRadius="14" BorderBrush="#BDBDBD" BorderThickness="1">
        <Grid ClipToBounds="True">
            <wv2:WebView2 x:Name="Browser" />

            <!-- Safari風に、サイト上へ浮かぶ独立した操作ボタン -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0">
                <Button x:Name="BackButton" Content="‹" Width="30" Height="30" FontSize="22" Padding="0,-5,0,0"
                        ToolTip="戻る" Click="BackButton_Click" Background="#F7F7F7" BorderBrush="#D0D0D0" />
                <Button x:Name="ForwardButton" Content="›" Width="30" Height="30" Margin="5,0,0,0" FontSize="22" Padding="0,-5,0,0"
                        ToolTip="進む" Click="ForwardButton_Click" Background="#F7F7F7" BorderBrush="#D0D0D0" />
            </StackPanel>

            <Button x:Name="CloseButton" Content="×" Width="30" Height="30"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                    FontSize="19" Padding="0,-3,0,0" ToolTip="閉じる"
                    Click="CloseButton_Click" Background="#F7F7F7" BorderBrush="#D0D0D0" />
        </Grid>
    </Border>
</Window>
