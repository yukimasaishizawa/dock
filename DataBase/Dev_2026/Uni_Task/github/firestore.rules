rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Each signed-in user can access only the workspace whose path contains their UID.
    match /users/{uid}/items/{itemId} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.id == itemId
        && request.resource.data.kind in ['Task', 'Event', 'Reminder'];
      allow delete: if signedInAs(uid);
    }

    // Task-specific links are stored separately so a task can have many URLs.
    match /users/{uid}/itemUrls/{urlId} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['itemId', 'url', 'order'])
        && request.resource.data.itemId is string
        && request.resource.data.url is string
        && request.resource.data.order is int;
      allow delete: if signedInAs(uid);
    }

    // URL dictionary entries are individual documents, not one growing array.
    match /users/{uid}/dictionary/{entryId} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.id == entryId
        && request.resource.data.key is string
        && request.resource.data.url is string
        && request.resource.data.keys().hasOnly(['id', 'key', 'url', 'updatedAtMs'])
        && (!('updatedAtMs' in request.resource.data) || request.resource.data.updatedAtMs is int);
      allow delete: if signedInAs(uid);
    }

    // Everything not explicitly allowed above is denied by default.
  }
}
